# =====================================================================================
# AquaGrid deployment environment
#
# Copy to `.env` in the deploy/ directory and fill in. `.env` is git-ignored.
# Every value here is a secret or an environment fact; none of them belong in the image.
# =====================================================================================

# ---- Database ------------------------------------------------------------------------
POSTGRES_DB=aquagrid
POSTGRES_USER=aquagrid
POSTGRES_PASSWORD=            # required — generate with: openssl rand -base64 24
POSTGRES_PORT=5432

# ---- Application ---------------------------------------------------------------------
API_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# Public origin of the SPA. Used to build password-reset links, so it must be exact.
APP_BASE_URL=https://aquagrid.example.com

# Exact allowed browser origins. Comma-separated. Wildcards are rejected at startup:
# the API is used with credentials, where a wildcard origin is both forbidden by the CORS
# spec and dangerous.
CORS_ORIGINS=https://aquagrid.example.com

# CIDR of the reverse proxy. Only traffic from inside this range may set X-Forwarded-For
# and be believed. NEVER set this to 0.0.0.0/0 — that restores the header-spoofing
# vulnerability that account lockout and login rate limiting depend on being absent.
TRUSTED_PROXIES=172.16.0.0/12

# ---- Cryptography --------------------------------------------------------------------
# Base64 256-bit key for field-level encryption (TOTP seeds, and device credentials from
# Module 6). Rotating this without re-encrypting makes existing MFA seeds undecryptable.
#   openssl rand -base64 32
AQUAGRID_MASTER_KEY=

# ---- Token signing -------------------------------------------------------------------
# RS256 key pair. The private key never leaves the API; every future microservice validates
# offline against /.well-known/jwks.json.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Supply as single-line values with \n escapes, or mount as Docker secrets.
JWT_ISSUER=https://aquagrid.example.com
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---- First administrator -------------------------------------------------------------
# Used ONCE, on an installation with no users. The account is created with
# must_change_password set, because an environment variable is visible in process listings,
# deployment manifests and shell history — treat it as compromised from birth.
# Unset this after the first successful start.
AQUAGRID_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AQUAGRID_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Optional module services --------------------------------------------------------
# GEOSERVER_ADMIN_PASSWORD=      # --profile gis  (Module 4)
# MQTT_PORT=1883                 # --profile iot  (Module 18)

# ---- IoT transports (Module 6/18) ---------------------------------------------------
# Each transport is independently activatable. Enable only the ones a deployment uses — an
# inactive transport compiles its beans away (no route, no socket, no listener).
# The simulator MUST stay false in production: it generates fictional telemetry that is
# indistinguishable from real data. The boot verifier refuses to start otherwise.
IOT_HTTP_ENABLED=true
IOT_LORAWAN_ENABLED=false
IOT_NBIOT_ENABLED=false
IOT_MQTT_ENABLED=false
# MQTT_BROKER_URL=tcp://broker.local:1883   # only when IOT_MQTT_ENABLED=true
IOT_SIMULATOR_ENABLED=false
# Phase-5 webhook POST /api/v1/ingest/http — must stay false in production.
IOT_LEGACY_HTTP_INGEST_ENABLED=false

# ---- HTTP receiver (POST /api/v1/receiver/http) --------------------------------------
IOT_RECEIVER_ENABLED=true
RECEIVER_REQUIRE_AUTH=true
# Optional CIDR allow-list (comma-separated). Required only when RECEIVER_REQUIRE_AUTH=false.
# RECEIVER_IP_ALLOW_LIST=10.0.0.0/8
RECEIVER_GATEWAY_PRINCIPAL=gateway
# Hex SHA-256 of the gateway API key. Generate: printf '%s' 'your-key' | sha256sum
# Leave empty only if every device authenticates with a device token or HMAC.
RECEIVER_GATEWAY_API_KEY_SHA256=
# RECEIVER_MAX_PACKET_BYTES=65536
# RECEIVER_PPM_DEVICE=120
# RECEIVER_PPM_SOURCE=30000

