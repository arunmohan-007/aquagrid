<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging policy.

  Development: human-readable console output.
  Everything else: single-line JSON, so logs are queryable in Loki/ELK/CloudWatch without
  multiline stitching, and every line carries traceId, userId and orgId from the MDC —
  which is what makes an incident traceable from an HTTP response back to a SQL statement.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <springProfile name="local,dev,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) [%X{traceId:-}] - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!local &amp; !dev &amp; !test">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <layout class="ch.qos.logback.classic.PatternLayout">
                    <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC}","level":"%level","app":"${appName}","logger":"%logger{40}","thread":"%thread","traceId":"%X{traceId:-}","userId":"%X{userId:-}","orgId":"%X{orgId:-}","message":"%replace(%msg){'"','\\"'}"%n</pattern>
                </layout>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
