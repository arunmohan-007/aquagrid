<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aquagrid</groupId>
        <artifactId>aquagrid-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-gis</artifactId>
    <name>AquaGrid :: GIS Module</name>
    <description>Spatial assets, vector tiles and the GIS dashboard backend (Module 4)</description>

    <dependencies>
        <!--
            Depends on platform-common only. It does NOT depend on module-identity: GIS resolves
            "who owns this asset" through TenantContext (organization_id from the JWT), never by
            joining to identity.users. This is what keeps the GIS module extractable.
        -->
        <dependency>
            <groupId>com.aquagrid</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aquagrid</groupId>
            <artifactId>platform-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!--
            Excel export of the asset register (Data Management). Version is managed in the parent,
            the same one module-iot uses for reading exports — two POI versions on one classpath is
            a NoSuchMethodError waiting for whichever export runs second.
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
    </dependencies>
</project>
