# Frontend environment.
#
# Leave VITE_API_BASE_URL unset for local development: Vite proxies /api to the backend,
# which keeps the browser same-origin. That matters because the refresh token is an
# `HttpOnly; SameSite=Strict` cookie, and a cross-origin dev setup makes the browser
# refuse to store or send it — producing a cookie problem that does not exist in
# production behind nginx.
#
# Only set it when pointing the SPA at a genuinely different origin, and configure that
# origin in the backend's aquagrid.web.cors-origins as well.
# VITE_API_BASE_URL=https://api.aquagrid.example.com/api/v1

VITE_APP_NAME=AquaGrid
